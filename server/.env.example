# Copy this file to .env and fill in real values before running the server.
# Never commit .env — it is already covered by .gitignore.

# Required. Signs and verifies moderator JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required. Authenticates SDK -> backend decision reports (the x-api-key
# header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=

# Comma-separated list of origins allowed to call this server's browser-facing
# endpoints (e.g. https://app.example.com). Leave empty to block all
# cross-origin requests (same-origin/non-browser callers still work).
ALLOWED_ORIGINS=

PORT=8787
