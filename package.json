{
  "name": "aegis-edge",
  "version": "0.1.0",
  "description": "On-device content safety for chat, images, and voice. Runs entirely in the browser — no content ever leaves the user's device.",
  "type": "module",
  "main": "src/aegis-edge.js",
  "exports": {
    ".": "./src/aegis-edge.js"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "./scripts/setup-models.sh",
    "serve": "npx serve .",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "content-moderation",
    "trust-and-safety",
    "toxicity-detection",
    "nsfw-detection",
    "on-device",
    "edge-ai",
    "privacy",
    "transformers.js",
    "onnx"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaiMotoi/Aegis-Edge.git"
  },
  "engines": {
    "node": ">=18"
  }
}
